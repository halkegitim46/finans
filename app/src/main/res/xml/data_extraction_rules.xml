<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ bulut yedeği ve cihazdan cihaza aktarım: uygulama verisi (şifreli veritabanı, anahtar dosyası, tercihler)
  hiçbir kanaldan dışarı çıkarılmaz. Veri taşıma yolu yalnızca uygulama içindeki parolayla şifreli yedek dosyasıdır.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
